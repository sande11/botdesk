# Secrets for BotDesk's Edge Functions.
# Local:      copy to supabase/functions/.env  (git-ignored) and run
#             npx supabase functions serve --env-file supabase/functions/.env
# Production: supabase secrets set NAME=value ...

# Signs widget sessions. 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# Shared by pg_cron and the worker function. Also store it in Vault as
# botdesk_worker_secret (see README → Deploy).
WORKER_SECRET=

# Public URL of the functions, used in webhook URLs and Twilio signatures.
# Defaults to $SUPABASE_URL/functions/v1.
PUBLIC_API_URL=

# Platform model keys: used by workspaces that have no key of their own,
# when their plan includes platform AI. Leave empty to require own keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Emails (hand-off alerts, invites) via Resend.
RESEND_API_KEY=
EMAIL_FROM=BotDesk <noreply@yourdomain.com>
# Used for links in emails.
DASHBOARD_URL=http://localhost:5173

# Local development only: answer with deterministic fake models, no keys needed.
BOTDESK_FAKE_AI=
