{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "unpdf": "npm:unpdf@1",
    "linkedom": "npm:linkedom@0.18",
    "fflate": "npm:fflate@0.8",
    "@std/assert": "jsr:@std/assert@1"
  },
  "lock": false,
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": false,
    "singleQuote": true
  }
}
