# Dashboard (browser). Copy to .env.local.
# Local: values printed by `npx supabase start` (API_URL and PUBLISHABLE_KEY / ANON_KEY).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Optional: where the Edge Functions live, if not at <SUPABASE_URL>/functions/v1.
# VITE_FUNCTIONS_URL=
# Where the widget script is served from (this dashboard's URL in production).
VITE_WIDGET_URL=http://localhost:5173/widget.js

# Edge Function secrets live in supabase/functions/.env.example.
